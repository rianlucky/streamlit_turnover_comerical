
# Copie este arquivo para .streamlit/secrets.toml (não versionado — veja .gitignore)
# e preencha com a connection string real do seu projeto no Neon.
# No Neon: Dashboard do projeto -> "Connect" -> copie a "Connection string".
# Garanta que comece com "postgresql://" (o Neon às vezes mostra "postgres://" -
# troque o prefixo se for o caso) e mantenha "?sslmode=require" no final.

# Usuário DEDICADO do painel (app_turnover) — só lê turnover.people_rows,
# turnover.sync_meta e o login. É o único bloco [connections.sql] que vai pros
# Secrets do Streamlit Cloud.
[connections.sql]
url = "postgresql://app_turnover:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# SÓ LOCAL (nunca no Streamlit Cloud): usuário de carga (etl_loader), usado por
# scripts/sync_from_databricks.py, scripts/load_people_data.py e scripts/grant_access.py.
[etl]
url = "postgresql://etl_loader:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# O Neon fecha conexões ociosas do lado do servidor; sem isso o pool do SQLAlchemy
# tenta reusar uma conexão morta e estoura "SSL connection has been closed
# unexpectedly". IMPORTANTE: isso também precisa ser adicionado nos "Secrets" do
# app no Streamlit Cloud (Manage app -> Settings -> Secrets) — este arquivo local
# não versionado não chega lá sozinho.
[connections.sql.create_engine_kwargs]
pool_pre_ping = true
pool_recycle = 300

# --- Databricks (teste de conexão local — scripts/test_databricks.py) ---
# Dados fixos da aba "Connection details" do SQL Warehouse no Databricks.
# Preencha SOMENTE UMA das credenciais abaixo, conforme o que o time liberar:
# - PAT: preencha "token" e apague/deixe em branco client_id/client_secret.
# - M2M (service principal): preencha client_id/client_secret e apague/deixe "token" em branco.
[databricks]
server_hostname = "dbc-282e0e97-2525.cloud.databricks.com"
http_path = "/sql/1.0/warehouses/c5779e7721b74226"
token = ""
client_id = ""
client_secret = ""
# Nome do gestor usado no ranking de reportes da query de sync_from_databricks.py.
# Fica só aqui (nunca hardcoded no script) porque o repositório é público.
gestor_referencia = "Nome Sobrenome"

# E-mail mostrado para quem ainda não tem acesso ("solicite a inclusão para ...")
[app]
email_suporte = "seu.email@empresa.com"
